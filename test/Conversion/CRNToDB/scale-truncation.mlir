// Behaviour against a database large enough for the candidate cap to bind.
//
// Inputs/large-db.json is 5,000 synthetic motifs carrying the signature skew
// measured over the real database: (-1,-1,1,1) holds 26.3% of records,
// (-1,-1,1,1,1) 16.1%, (-1,1) 11.9%. It is generated by
// Inputs/gen-large-db.py rather than derived from MotifsDB, whose CSVs are
// untracked in the submodule -- the test has to run on a fresh clone.
//
// This is the case the CF26-CRN2DB evaluation does not cover. Section 4.3
// assumes "|Cand| <= 100 for most abstract reactions"; at full scale,
// signature indexing alone leaves thousands of candidates for the commonest
// reaction shapes, so the cap is what keeps matching tractable, and capping
// makes the result heuristic rather than exact.

// RUN: chemcomp-opt %s -crn-db-match='db=%S/Inputs/large-db.json max-candidates=64' \
// RUN:   -verify-diagnostics | FileCheck %s

// Uncapped, the same query still completes -- slower, and without the remark.
// RUN: chemcomp-opt %s -crn-db-match='db=%S/Inputs/large-db.json max-candidates=0' \
// RUN:   | FileCheck %s --check-prefix=UNCAPPED

acr.crn @common(%sv: tensor<4x!acr.species>, %rv: tensor<1xf32>)
    -> tensor<4x!acr.species> {
  // Truncation must never be silent: a capped run is no longer the exact
  // algorithm, and the caller has to be told.
  // expected-remark @+1 {{candidate set for reaction 0 truncated from 2663 to 64; the result is heuristic rather than optimal}}
  %out = acr.crn_generic
      {stoich_matrix = dense<[[-1, -1, 1, 1]]> : tensor<1x4xi32>}
      (%sv, %rv) : (tensor<4x!acr.species>, tensor<1xf32>)
                -> tensor<4x!acr.species>
  acr.return %out : tensor<4x!acr.species>
}

// A match is still found, and the cap keeps the lowest motif ids, so which one
// is deterministic.
// CHECK: acr.crn_generic
// CHECK-SAME: motif_ids = ["syn000000"]

// UNCAPPED: acr.crn_generic
// UNCAPPED-SAME: motif_ids = ["syn000000"]
// UNCAPPED-NOT: truncated
